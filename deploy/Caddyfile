# Caddy terminates TLS and proxies to the Next.js standalone server, which
# binds to loopback only. Certificates are issued and renewed automatically.
aion.neoxify.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		# Content-Security-Policy is issued by the panel itself (apps/web/middleware.ts),
		# with a fresh nonce per request. A fixed one here blocked Next's inline
		# scripts and left every page on its loading skeleton.
		-Server
	}

	# Next's Server Action CSRF check compares Origin against x-forwarded-host,
	# so the proxy sets it rather than trusting whatever arrives.

	reverse_proxy 127.0.0.1:3100 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}
}
