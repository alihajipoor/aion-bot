# Line endings: LF everywhere, on every OS.
#
# deploy/scripts/*.sh run under bash on the VPS. Git for Windows defaults to
# core.autocrlf=true, which writes CRLF into the working copy — and a script
# committed back with \r in it fails on the server with "$'\r': command not
# found", taking every deploy down from a change that was otherwise fine.
# Pinning LF here makes the repository decide, not each machine's git config.
* text=auto eol=lf
*.sh text eol=lf

# Binaries are never rewritten.
*.png   binary
*.gif   binary
*.jpg   binary
*.jpeg  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
