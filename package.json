{
  "name": "aion",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bot:dev": "npm -w @aion/bot run dev",
    "build": "npm -w @aion/bot run build",
    "bot:build": "npm -w @aion/bot run build",
    "bot:start": "npm -w @aion/bot run start",
    "db:generate": "npm -w @aion/db run generate",
    "db:migrate": "npm -w @aion/db run migrate",
    "typecheck": "tsc -b --pretty",
    "test": "npm -w @aion/bot run build && node --test apps/bot/test/*.test.mjs"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "22.20.1",
    "gifenc": "^1.0.3",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "@types/node": "22.20.1"
  }
}
