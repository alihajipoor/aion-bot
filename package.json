{
  "name": "aion",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "bot:dev": "npm -w @aion/bot run dev",
    "bot:build": "npm -w @aion/bot run build",
    "bot:start": "npm -w @aion/bot run start",
    "db:generate": "npm -w @aion/db run generate",
    "db:migrate": "npm -w @aion/db run migrate",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": { "discord.js": "^14.27.0", "dotenv": "^17.2.1" }
}
